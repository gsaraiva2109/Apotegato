[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/ui/options_menu.gd" id="1_menu"]
[ext_resource type="Theme" path="res://scenes/ui/game_theme.tres" id="2_theme"]
[ext_resource type="Texture2D" path="res://assets/art/ui/icon_gear.png" id="3_gear"]
[ext_resource type="Texture2D" path="res://assets/art/ui/icon_sound.png" id="4_sound"]
[ext_resource type="Texture2D" path="res://assets/art/ui/icon_close.png" id="5_close"]

[node name="OptionsMenu" type="CanvasLayer"]
process_mode = 3
layer = 20
visible = false
script = ExtResource("1_menu")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")

[node name="Dim" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.7)

[node name="Center" type="CenterContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Root/Center"]
layout_mode = 2

[node name="Layout" type="VBoxContainer" parent="Root/Center/Panel"]
custom_minimum_size = Vector2(680, 0)
layout_mode = 2
theme_override_constants/separation = 10

[node name="TitleRow" type="HBoxContainer" parent="Root/Center/Panel/Layout"]
layout_mode = 2
theme_override_constants/separation = 10
alignment = 1

[node name="TitleIcon" type="TextureRect" parent="Root/Center/Panel/Layout/TitleRow"]
custom_minimum_size = Vector2(36, 36)
layout_mode = 2
size_flags_vertical = 4
texture = ExtResource("3_gear")
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="TitlePlank" type="PanelContainer" parent="Root/Center/Panel/Layout/TitleRow"]
