theme_type_variation = &"PlankLabel"
theme_override_font_sizes/font_size = 24
text = "Opções"
horizontal_alignment = 1

[node name="Tabs" type="HBoxContainer" parent="Root/Center/Panel/Layout"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="SoundTab" type="Button" parent="Root/Center/Panel/Layout/Tabs"]
custom_minimum_size = Vector2(140, 0)
layout_mode = 2
