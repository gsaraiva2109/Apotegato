size_flags_vertical = 3
theme_override_colors/font_color = Color(0.85, 0.8, 0.7, 1)
text = "Reduzir efeitos troca as piscadas (como a do Mingau ao levar dano) por versões estáticas e vale também para efeitos futuros, como o tremor de câmera. Texto grande aumenta todos os textos do jogo em 25%."
